# 本機測試用範例，複製成 .env 後填入真實值（.env 已在 .gitignore，不會被 commit）
ANTHROPIC_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
# 個人測試階段：填你自己的 LINE User ID（U 開頭）
# 正式階段：換成群組 Group ID（C 開頭），多個目標用逗號分隔
LINE_PUSH_TARGET_IDS=

# 以下留空 = 改跑 config/must_watch.json 全部標的
MAIN=
COMPARE=
CAPITAL=200000
RISK_PCT=2
RS_LOOKBACK=25
RS_PASS=2
STOP_LOSS_PCT=8
TARGET_PCT=20
USE_WEB_SEARCH=true
